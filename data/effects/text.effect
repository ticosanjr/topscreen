// TopScreen - text effect (glyph sprites) and background band.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float4 color;

uniform float2 band_size;
uniform float  band_radius;
uniform float4 band_color;

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos   : POSITION;
	float2 uv    : TEXCOORD0;
	float4 vcol  : COLOR;
};

VertInOut VSText(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos  = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv   = vert_in.uv;
	vert_out.vcol = vert_in.vcol;
	return vert_out;
}

float4 PSText(VertInOut vert_in) : TARGET
{
	float4 c = image.Sample(def_sampler, vert_in.uv);
	// Shadow vertices are black, main vertices are white. The uniform still
	// carries the configured text color, so one draw covers both.
	return float4(color.rgb * vert_in.vcol.rgb, c.a * color.a * vert_in.vcol.a);
}

float sdBand(float2 p, float2 b, float r)
{
	float2 q = abs(p) - b + r;
	return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

float4 PSBand(VertInOut vert_in) : TARGET
{
	float2 p = (vert_in.uv - 0.5) * band_size;
	float2 h = band_size * 0.5;
	float  d = sdBand(p, h, band_radius);
	float  a = (1.0 - smoothstep(-1.0, 1.0, d)) * band_color.a;
	return float4(band_color.rgb, a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSText(vert_in);
		pixel_shader  = PSText(vert_in);
	}
}

technique Band
{
	pass
	{
		vertex_shader = VSText(vert_in);
		pixel_shader  = PSBand(vert_in);
	}
}
