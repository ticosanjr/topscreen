// TopScreen - main effect.
//
// Background (solid/gradient), rounded corners (SDF with anti-aliasing),
// padding, approximate shadow, zoom/pan, cursor and click effects, all in
// a single pass. The syntax is compiled by OBS to HLSL (D3D11) and GLSL
// (OpenGL).
//
// Note: like OBS's own shaders, this effect does NOT use uniform arrays
// or loops - the click effects use 4 explicit slots.

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 target_size;   // output resolution (px)
uniform float2 content_pad;   // internal padding (px) - x/y
uniform float  corner_radius; // corner radius (px)
uniform float  zoom;          // >= 1
uniform float2 zoom_focus;    // 0..1 (zoom center)
uniform float4 bg_a;
uniform float4 bg_b;
uniform float  bg_mode;       // 0 solid, 1 gradient, 2 wallpaper
uniform float2 bg_gradient_center; // 0..1, point where the colors meet
uniform float2 bg_gradient_dir;    // unit direction, computed on the CPU
uniform texture2d bg_tex;     // wallpaper
uniform float  bg_tex_enabled;
uniform float  bg_transparent; // 1 = transparent outside the floating screen
uniform float  bg_tex_aspect; // image w/h
uniform float  bg_keep_aspect;
uniform float  bg_blur;       // wallpaper blur (px)
uniform float  bg_blur_type;  // 0 none, 1 soft(box), 2 gaussian, 3 creamy
uniform float  shadow_alpha;
uniform float  shadow_blur;
uniform float2 shadow_offset;

uniform float  cursor_enabled;
uniform float2 cursor_pos;      // content coordinate (0..1)
uniform float  cursor_scale;    // size multiplier
uniform float  cursor_opacity;
uniform float  cursor_rotation; // rad
uniform float  cursor_shadow;

// Bitmap cursor (atlas). If unavailable, falls back to procedural.
uniform texture2d cursor_tex;
uniform float  cursor_tex_enabled;
uniform float2 cursor_cell_off;   // uv of the selected cell in the atlas
uniform float2 cursor_cell_scale; // cell size in uv
uniform float2 cursor_hotspot;    // 0..1 (hotspot inside the icon)

uniform float  zoom_blur;        // 0..1 (zoom motion blur)
uniform float  spotlight_enabled;
uniform float  spotlight_amount; // 0..1 activation animation
uniform float  spotlight_shape;  // 0 circle, 1 square
uniform float  spotlight_radius; // fraction of the shorter side
uniform float  spotlight_corner; // square corner radius (px)
uniform float  spotlight_dim;    // 0..1
uniform float  spotlight_border_enabled;
uniform float4 spotlight_border_color;
uniform float  spotlight_border_width; // px
uniform float  spotlight_shadow_enabled;
uniform float4 spotlight_shadow_color;
uniform float  spotlight_shadow_alpha;
uniform float  spotlight_shadow_blur; // px
uniform float2 spotlight_shadow_offset;
uniform float  spotlight_blur_enabled;
uniform float  spotlight_blur;   // px
uniform float  spotlight_zoom;   // multiplicative scene zoom
uniform float2 spotlight_focus;  // source uv under the cursor
uniform float  spotlight_drop;   // vertical drop offset (px)

uniform float  magnifier_enabled;
uniform float  magnifier_amount;
uniform float  magnifier_shape;
uniform float  magnifier_radius;
uniform float  magnifier_corner;
uniform float  magnifier_zoom;
uniform float2 magnifier_focus;  // content uv under the lens
uniform float  magnifier_drop;
uniform float  magnifier_border_enabled;
uniform float4 magnifier_border_color;
uniform float  magnifier_border_width;
uniform float  magnifier_shadow_enabled;
uniform float4 magnifier_shadow_color;
uniform float  magnifier_shadow_alpha;
uniform float  magnifier_shadow_blur;
uniform float2 magnifier_shadow_offset;

uniform float  highlight_active;
uniform float4 highlight_rect;   // x0,y0,x1,y1 (content 0..1)
uniform float4 highlight_color;  // rgba
uniform float  highlight_alpha;

/* Freehand line: up to 16 polyline points (content 0..1), unrolled on
 * purpose like the click slots (no arrays, no dynamic loops). */
uniform float  line_count;
uniform float  line_width;   // px
uniform float2 line_p0;
uniform float2 line_p1;
uniform float2 line_p2;
uniform float2 line_p3;
uniform float2 line_p4;
uniform float2 line_p5;
uniform float2 line_p6;
uniform float2 line_p7;
uniform float2 line_p8;
uniform float2 line_p9;
uniform float2 line_p10;
uniform float2 line_p11;
uniform float2 line_p12;
uniform float2 line_p13;
uniform float2 line_p14;
uniform float2 line_p15;

uniform float  click_count;

uniform float2 click0_pos;
uniform float  click0_prog;
uniform float  click0_size;
uniform float4 click0_color;
uniform float  click0_type;

uniform float2 click1_pos;
uniform float  click1_prog;
uniform float  click1_size;
uniform float4 click1_color;
uniform float  click1_type;

uniform float2 click2_pos;
uniform float  click2_prog;
uniform float  click2_size;
uniform float4 click2_color;
uniform float  click2_type;

uniform float2 click3_pos;
uniform float  click3_prog;
uniform float  click3_size;
uniform float4 click3_color;
uniform float  click3_type;

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

// Sign (avoids depending on sign() in the OBS translator).
float sgn(float x)
{
	return x < 0.0 ? -1.0 : 1.0;
}

// Length (avoids depending on length()).
float len2(float2 v)
{
	return sqrt(dot(v, v));
}

// 2D rotation.
float2 rotate2(float2 p, float a)
{
	float s = sin(a);
	float c = cos(a);
	return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

// Distance from a pixel to a segment, in pixels.
float seg_dist(float2 p, float2 a, float2 b)
{
	float2 pa = p - a;
	float2 ba = b - a;
	float t = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
	return len2(pa - ba * t);
}

// Signed distance to a rounded rectangle centered at the origin.
float sd_round_box(float2 p, float2 half_extents, float radius)
{
	float2 q = abs(p) - half_extents + radius;
	return min(max(q.x, q.y), 0.0) + len2(max(q, 0.0)) - radius;
}

// Signed distance to a triangle (for the cursor).
float sd_triangle(float2 p, float2 p0, float2 p1, float2 p2)
{
	float2 e0 = p1 - p0;
	float2 e1 = p2 - p1;
	float2 e2 = p0 - p2;
	float2 v0 = p - p0;
	float2 v1 = p - p1;
	float2 v2 = p - p2;

	float2 pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
	float2 pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
	float2 pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);

	float s = sgn(e0.x * e2.y - e0.y * e2.x);
	float2 d = min(min(float2(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x)),
			   float2(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x))),
		       float2(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x)));

	return -sqrt(d.x) * sgn(d.y);
}

// Size of the content area (minus the padding; with an option to keep aspect ratio).
float2 content_size()
{
	float2 area = max(target_size - content_pad * 2.0, float2(1.0, 1.0));
	if (bg_keep_aspect > 0.5) {
		float sc = min(area.x / max(target_size.x, 1.0), area.y / max(target_size.y, 1.0));
		area = target_size * sc;
	}
	return area;
}

// Top-left corner of the content area.
float2 content_origin()
{
	return (target_size - content_size()) * 0.5;
}

// Effective scene zoom/focus: the spotlight adds its own multiplicative zoom
// and moves the focus to the cursor while it is active.
float scene_zoom_value()
{
	return max(zoom, 1.0) * max(spotlight_zoom, 1.0);
}

float2 scene_focus_value()
{
	return lerp(zoom_focus, spotlight_focus, saturate(spotlight_amount));
}

// DISPLAYED position, in pixels, of a SOURCE point (content uv).
//
// The screen is sampled with u = f + (c - f)/zoom; so a source point s
// appears at c = f + (s - f)*zoom. Inverting this here is what keeps cursor,
// clicks, spotlight and highlight glued to the right place.
float2 content_to_pixel(float2 cu)
{
	float2 cs = content_size();
	float2 f  = scene_focus_value();
	float2 su = f + (cu - f) * scene_zoom_value();
	return su * cs + content_origin();
}

// Signed distance to the spotlight shape, in pixels. Positive = outside.
float spotlight_sd(float2 px)
{
	float2 cpx = content_to_pixel(cursor_pos) + float2(0.0, spotlight_drop);
	float  rad = max(spotlight_radius, 0.001) * min(target_size.x, target_size.y);
	if (spotlight_shape > 0.5) {
		float cr = clamp(spotlight_corner, 0.0, rad);
		return sd_round_box(px - cpx, float2(rad, rad), cr);
	}
	return len2(px - cpx) - rad;
}

// Signed distance to the magnifier lens, in pixels. Positive = outside.
float magnifier_sd(float2 px)
{
	float2 cpx = content_to_pixel(magnifier_focus) + float2(0.0, magnifier_drop);
	float  rad = max(magnifier_radius, 0.001) * min(target_size.x, target_size.y);
	if (magnifier_shape > 0.5) {
		float cr = clamp(magnifier_corner, 0.0, rad);
		return sd_round_box(px - cpx, float2(rad, rad), cr);
	}
	return len2(px - cpx) - rad;
}

// Composes a click effect over the current color.
float4 apply_click(float4 col, float2 px, float mask, float2 cu, float prog, float csize,
		   float4 ccol, float type)
{
	float2 local = px - content_to_pixel(cu);
	float  base  = target_size.y * 0.08;
	float  r     = max(base * csize * prog, 0.0);
	float  aa    = max(target_size.y * 0.0015, 1.0);
	float  dist  = len2(local);
	float  a     = 0.0;

	if (type < 0.5) {
		// ripple: ring with a medium edge
		float th = max(base * csize * 0.18, aa);
		a        = (1.0 - smoothstep(th - aa, th + aa, abs(dist - r))) * (1.0 - prog);
	} else if (type < 1.5) {
		// orb: filled disc that grows and fades
		a = (1.0 - smoothstep(-aa, aa, dist - r)) * (1.0 - prog) * 0.8;
	} else if (type < 2.5) {
		// ring: thin ring
		float th = max(base * csize * 0.08, aa);
		a        = (1.0 - smoothstep(th - aa, th + aa, abs(dist - r))) * (1.0 - prog);
	} else if (type < 3.5) {
		// force: thick ring
		float th = max(base * csize * 0.40, aa);
		a        = (1.0 - smoothstep(th - aa, th + aa, abs(dist - r))) * (1.0 - prog) * 1.2;
	} else if (type < 4.5) {
		// glow: soft filled glow
		a = (1.0 - smoothstep(-aa, r * 0.9 + aa, dist - r * 0.1)) * (1.0 - prog) * 0.55;
	} else if (type < 5.5) {
		// echo: double ring
		float th = max(base * csize * 0.08, aa);
		float r2 = r * 0.55;
		float e1 = 1.0 - smoothstep(th - aa, th + aa, abs(dist - r));
		float e2 = (1.0 - smoothstep(th - aa, th + aa, abs(dist - r2))) * 0.7;
		a        = (e1 + e2) * (1.0 - prog);
	} else if (type < 6.5) {
		// flare: 4-point spark over a small disc
		float dia = abs(local.x) + abs(local.y);
		float arm = max(base * csize * 0.10, aa);
		float a1  = (1.0 - smoothstep(-aa, aa, dist - r * 0.7)) * 0.5;
		float a2  = (1.0 - smoothstep(arm - aa, arm + aa, dia)) *
			   (1.0 - smoothstep(-aa, aa, dist - r));
		a = (a1 + a2) * (1.0 - prog);
	} else if (type < 7.5) {
		// quiet circle: soft translucent disc with a very thin edge
		float disc = 1.0 - smoothstep(r - aa, r + aa, dist);
		float edge = 1.0 - smoothstep(aa, aa * 3.0, abs(dist - r));
		a = disc * 0.18 + edge * 0.12;
		a *= (1.0 - prog);
	} else {
		// water ripple: soft expanding ring; the pixel distortion itself is
		// applied in ripple_offset() while sampling the captured image.
		float th = max(base * csize * 0.06, aa);
		a = (1.0 - smoothstep(th - aa, th + aa, abs(dist - r))) * (1.0 - prog) * 0.35;
	}

	a *= ccol.a * mask;
	col.rgb = lerp(col.rgb, ccol.rgb, saturate(a));
	return col;
}

/* Radial UV displacement for the "Water ripple" click effect.
 *
 * The displacement is computed in display pixels, then converted back to
 * source UV units so it stays glued to the click while the scene is zoomed. */
float2 ripple_one(float2 cu, float2 center, float prog, float csize)
{
	float2 cs = content_size();
	float2 delta = (cu - center) * cs * scene_zoom_value();
	float dist = len2(delta);
	float base = target_size.y * 0.08 * max(csize, 0.2);
	float radius = base * prog;
	float width = max(base * 0.22, 1.0);
	float d = dist - radius;
	float ring = (1.0 - smoothstep(-width, width, abs(d))) * (1.0 - prog);
	float2 dir = dist > 0.001 ? delta / dist : float2(0.0, 0.0);
	float amplitude = target_size.y * 0.012 * max(csize, 0.2) * (1.0 - prog) * ring;
	return dir * amplitude / max(cs * scene_zoom_value(), float2(1.0, 1.0));
}

float2 ripple_offset(float2 cu)
{
	float2 o = float2(0.0, 0.0);
	if (click_count > 0.5 && click0_type > 7.5)
		o += ripple_one(cu, click0_pos, click0_prog, click0_size);
	if (click_count > 1.5 && click1_type > 7.5)
		o += ripple_one(cu, click1_pos, click1_prog, click1_size);
	if (click_count > 2.5 && click2_type > 7.5)
		o += ripple_one(cu, click2_pos, click2_prog, click2_size);
	if (click_count > 3.5 && click3_type > 7.5)
		o += ripple_one(cu, click3_pos, click3_prog, click3_size);
	return o;
}

/* Fast 3x3 diffusion: 9 taps. Used by the "Soft" mode. */
float4 blur9(float2 uv, float2 o)
{
	float4 c = bg_tex.Sample(def_sampler, uv) * 0.25;
	c += bg_tex.Sample(def_sampler, uv + float2(o.x, 0.0)) * 0.125;
	c += bg_tex.Sample(def_sampler, uv - float2(o.x, 0.0)) * 0.125;
	c += bg_tex.Sample(def_sampler, uv + float2(0.0, o.y)) * 0.125;
	c += bg_tex.Sample(def_sampler, uv - float2(0.0, o.y)) * 0.125;
	c += bg_tex.Sample(def_sampler, uv + o) * 0.0625;
	c += bg_tex.Sample(def_sampler, uv - o) * 0.0625;
	c += bg_tex.Sample(def_sampler, uv + float2(o.x, -o.y)) * 0.0625;
	c += bg_tex.Sample(def_sampler, uv - float2(o.x, -o.y)) * 0.0625;
	return c;
}

/* 5x5 Gaussian (sigma = 1 grid unit, 25 taps). The weights are the outer
 * product of the 1D Gaussian [0.0545, 0.2442, 0.4026, 0.2442, 0.0545].
 * At larger radii this avoids the discrete "repeated pixel" look of a
 * stretched 3x3 kernel. */
float4 blur25(float2 uv, float2 step)
{
	float4 c = float4(0.0, 0.0, 0.0, 0.0);
	c += bg_tex.Sample(def_sampler, uv + step * float2(-2.0, -2.0)) * 0.002969;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-1.0, -2.0)) * 0.013306;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 0.0, -2.0)) * 0.021938;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 1.0, -2.0)) * 0.013306;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 2.0, -2.0)) * 0.002969;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-2.0, -1.0)) * 0.013306;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-1.0, -1.0)) * 0.059634;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 0.0, -1.0)) * 0.098320;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 1.0, -1.0)) * 0.059634;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 2.0, -1.0)) * 0.013306;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-2.0,  0.0)) * 0.021938;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-1.0,  0.0)) * 0.098320;
	c += bg_tex.Sample(def_sampler, uv) * 0.162103;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 1.0,  0.0)) * 0.098320;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 2.0,  0.0)) * 0.021938;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-2.0,  1.0)) * 0.013306;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-1.0,  1.0)) * 0.059634;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 0.0,  1.0)) * 0.098320;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 1.0,  1.0)) * 0.059634;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 2.0,  1.0)) * 0.013306;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-2.0,  2.0)) * 0.002969;
	c += bg_tex.Sample(def_sampler, uv + step * float2(-1.0,  2.0)) * 0.013306;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 0.0,  2.0)) * 0.021938;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 1.0,  2.0)) * 0.013306;
	c += bg_tex.Sample(def_sampler, uv + step * float2( 2.0,  2.0)) * 0.002969;
	return c;
}

float4 PSCompose(VertInOut vert_in) : TARGET
{
	float2 px     = vert_in.uv * target_size;
	float2 center = target_size * 0.5;
	float2 p      = px - center;

	float2 content_half = content_size() * 0.5;
	float  radius       = min(corner_radius, min(content_half.x, content_half.y));
	radius              = max(radius, 0.0);

	// Background: wallpaper when selected, otherwise solid/gradient.
	// Transparent mode ignores both and clears the frame outside the screen.
	float4 col = bg_a;
	if (bg_transparent > 0.5) {
		col = float4(0.0, 0.0, 0.0, 0.0);
	} else if (bg_mode > 1.5) {
	    if (bg_tex_enabled > 0.5) {
		float at = target_size.x / max(target_size.y, 1.0);
		float ai = max(bg_tex_aspect, 0.0001);
		float2 sc = float2(1.0, 1.0);
		if (at > ai)
			sc.y = ai / at;
		else
			sc.x = at / ai;
		float2 buv = (vert_in.uv - 0.5) * sc + 0.5;

		if (bg_blur > 0.01 && bg_blur_type > 0.5) {
			float2 texel = 1.0 / max(target_size, float2(1.0, 1.0));

			if (bg_blur_type < 1.5) {
				// Soft: fast 3x3 diffusion (9 taps).
				float2 o = texel * bg_blur * 0.70;
				col = blur9(buv, o);
			} else {
				// Gaussian / Creamy / Frosted: real 5x5 Gaussian (25 taps).
				// Sampling a 3x3 kernel with a very wide spread used to
				// leave visible gaps at large radii (the "repeated pixel"
				// look). A 5x5 kernel keeps the taps dense enough to read as
				// frosted glass instead of a grid of ghosts.
				float spread = 0.50; // Gaussian
				if (bg_blur_type >= 2.5)
					spread = 0.62; // Creamy
				if (bg_blur_type >= 3.5)
					spread = 0.66; // Frosted glass

				float2 step = texel * bg_blur * spread;

				if (bg_blur_type >= 3.5) {
					// Sub-pixel rotation of the 5x5 grid breaks the
					// alignment between neighbouring pixels, which removes
					// the faint cross/plus pattern of a fixed kernel.
					float2 jitter = float2(
						frac(px.x * 0.7548777 + px.y * 0.5698403),
						frac(px.x * 0.4385791 + px.y * 0.9172837)) - 0.5;
					buv += jitter * step * 0.35;
				}

				col = blur25(buv, step);
			}
		} else {
			col = bg_tex.Sample(def_sampler, buv);
		}
	    } else {
		col = bg_a;
	    }
	} else if (bg_mode > 0.5) {
		float t = saturate(dot(vert_in.uv - bg_gradient_center, bg_gradient_dir) + 0.5);
		col = lerp(bg_a, bg_b, t);
	}

	// Approximate shadow
	if (shadow_alpha > 0.001) {
		float2 sp = p - shadow_offset;
		float  ds = sd_round_box(sp, content_half + shadow_blur, radius + shadow_blur);
		float  s  = 1.0 - smoothstep(-shadow_blur, shadow_blur, ds);
		if (bg_transparent > 0.5)
			col = float4(0.0, 0.0, 0.0, max(col.a, s * shadow_alpha));
		else
			col.rgb = lerp(col.rgb, float3(0.0, 0.0, 0.0), s * shadow_alpha);
	}

	// Magnifier outer shadow (behind the lens border/content).
	if (magnifier_enabled > 0.5 && magnifier_amount > 0.001 &&
	    magnifier_shadow_enabled > 0.5 && magnifier_shadow_alpha > 0.001) {
		float sd = magnifier_sd(px - magnifier_shadow_offset);
		float s = 1.0 - smoothstep(-magnifier_shadow_blur, magnifier_shadow_blur, sd);
		col.rgb = lerp(col.rgb, magnifier_shadow_color.rgb,
			       s * magnifier_shadow_alpha * magnifier_amount);
	}

	// Content: corner mask with anti-aliasing
	float dc   = sd_round_box(p, content_half, radius);
	float mask = 1.0 - smoothstep(-1.0, 1.0, dc);

	if (mask > 0.0) {
		float2 cs         = content_size();
		float2 content_uv = (px - content_origin()) / cs;
		// Distorts the captured image only; background and overlays stay sharp.
		content_uv += ripple_offset(content_uv);
		float2 focus      = scene_focus_value();
		float  scene_zoom = scene_zoom_value();
		float2 uv_screen  = focus + (content_uv - focus) / max(scene_zoom, 0.0001);

		float4 screen;
		if (zoom_blur > 0.001) {
			// Radial motion blur (approx. of the zoom movement)
			float2 d = (uv_screen - focus) * zoom_blur * 0.03;
			screen = image.Sample(def_sampler, uv_screen - d);
			screen += image.Sample(def_sampler, uv_screen);
			screen += image.Sample(def_sampler, uv_screen + d);
			screen *= (1.0 / 3.0);
		} else {
			screen = image.Sample(def_sampler, uv_screen);
		}

		// Magnifier: blend a locally zoomed sample inside the lens. The
		// spotlight zoom is global; this one changes only the lens area.
		if (magnifier_enabled > 0.5 && magnifier_amount > 0.001) {
			float lens_sd = magnifier_sd(px);
			float lens_mask = (1.0 - smoothstep(-1.0, 1.0, lens_sd)) * magnifier_amount;
			if (lens_mask > 0.001) {
				float2 base_focus = scene_focus_value();
				float base_zoom = scene_zoom_value();
				float2 lens_src = base_focus + (magnifier_focus - base_focus) /
							   max(base_zoom, 0.0001);
				float2 uv_lens = lens_src + (uv_screen - lens_src) /
							 max(magnifier_zoom, 1.0001);
				float4 magnified = image.Sample(def_sampler, uv_lens);
				screen = lerp(screen, magnified, lens_mask);
			}
		}

		float spot_amount = saturate(spotlight_amount);
		float spot_sd = spotlight_sd(px);
		float spot_outside = smoothstep(-1.0, 1.0, spot_sd);
		if (spotlight_enabled > 0.5 && spot_amount > 0.001 &&
		    spotlight_blur_enabled > 0.5 && spotlight_blur > 0.01 &&
		    spot_outside > 0.001) {
			// Blur only the captured image outside the spotlight (9 taps).
			float2 o = spotlight_blur / max(target_size, float2(1.0, 1.0));
			float4 blurred = image.Sample(def_sampler, uv_screen) * 0.25;
			blurred += image.Sample(def_sampler, uv_screen + float2(o.x, 0.0)) * 0.125;
			blurred += image.Sample(def_sampler, uv_screen - float2(o.x, 0.0)) * 0.125;
			blurred += image.Sample(def_sampler, uv_screen + float2(0.0, o.y)) * 0.125;
			blurred += image.Sample(def_sampler, uv_screen - float2(0.0, o.y)) * 0.125;
			blurred += image.Sample(def_sampler, uv_screen + o) * 0.0625;
			blurred += image.Sample(def_sampler, uv_screen - o) * 0.0625;
			blurred += image.Sample(def_sampler, uv_screen + float2(o.x, -o.y)) * 0.0625;
			blurred += image.Sample(def_sampler, uv_screen - float2(o.x, -o.y)) * 0.0625;
			screen = lerp(screen, blurred, spot_outside * spot_amount);
		}

		if (bg_transparent > 0.5)
			col = float4(screen.rgb, mask * screen.a);
		else
			col = lerp(col, screen, mask);

		// Magnifier border, drawn on top of the lens content.
		if (magnifier_enabled > 0.5 && magnifier_amount > 0.001 &&
		    magnifier_border_enabled > 0.5 && magnifier_border_width > 0.01) {
			float sd = magnifier_sd(px);
			float edge = 1.0 - smoothstep(-1.0, 1.0,
						      abs(sd) - magnifier_border_width * 0.5);
			col.rgb = lerp(col.rgb, magnifier_border_color.rgb,
				       edge * magnifier_border_color.a * magnifier_amount);
		}

		// Click effects (4 explicit slots)
		if (click_count > 0.5)
			col = apply_click(col, px, mask, click0_pos, click0_prog, click0_size, click0_color,
					  click0_type);
		if (click_count > 1.5)
			col = apply_click(col, px, mask, click1_pos, click1_prog, click1_size, click1_color,
					  click1_type);
		if (click_count > 2.5)
			col = apply_click(col, px, mask, click2_pos, click2_prog, click2_size, click2_color,
					  click2_type);
		if (click_count > 3.5)
			col = apply_click(col, px, mask, click3_pos, click3_prog, click3_size, click3_color,
					  click3_type);

		// Drag highlight
		if (highlight_active > 0.5) {
			float2 hp0 = content_to_pixel(highlight_rect.xy);
			float2 hp1 = content_to_pixel(highlight_rect.zw);
			float2 hc  = (hp0 + hp1) * 0.5;
			float2 hh  = abs(hp1 - hp0) * 0.5;
			float  hr  = min(hh.x, hh.y) * 0.25;
			float  hd  = sd_round_box(px - hc, hh, hr);
			float  ha  = (1.0 - smoothstep(-1.0, 1.0, hd)) * highlight_alpha * mask * highlight_color.a;
			col.rgb    = lerp(col.rgb, highlight_color.rgb, saturate(ha));
		}

		// Freehand line: polyline segments through the line points,
		// converted to pixels so the width stays constant on screen.
		if (line_count > 1.5) {
			float  aa = max(target_size.y * 0.0015, 1.0);
			float  line_hw = max(line_width * 0.5, aa * 0.5);
			float  line_alpha = highlight_alpha * mask * highlight_color.a;
			float  line_a = 0.0;
			if (line_count > 1.5) {
				float2 la = content_to_pixel(line_p0);
				float2 lb = content_to_pixel(line_p1);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 2.5) {
				float2 la = content_to_pixel(line_p1);
				float2 lb = content_to_pixel(line_p2);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 3.5) {
				float2 la = content_to_pixel(line_p2);
				float2 lb = content_to_pixel(line_p3);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 4.5) {
				float2 la = content_to_pixel(line_p3);
				float2 lb = content_to_pixel(line_p4);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 5.5) {
				float2 la = content_to_pixel(line_p4);
				float2 lb = content_to_pixel(line_p5);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 6.5) {
				float2 la = content_to_pixel(line_p5);
				float2 lb = content_to_pixel(line_p6);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 7.5) {
				float2 la = content_to_pixel(line_p6);
				float2 lb = content_to_pixel(line_p7);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 8.5) {
				float2 la = content_to_pixel(line_p7);
				float2 lb = content_to_pixel(line_p8);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 9.5) {
				float2 la = content_to_pixel(line_p8);
				float2 lb = content_to_pixel(line_p9);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 10.5) {
				float2 la = content_to_pixel(line_p9);
				float2 lb = content_to_pixel(line_p10);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 11.5) {
				float2 la = content_to_pixel(line_p10);
				float2 lb = content_to_pixel(line_p11);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 12.5) {
				float2 la = content_to_pixel(line_p11);
				float2 lb = content_to_pixel(line_p12);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 13.5) {
				float2 la = content_to_pixel(line_p12);
				float2 lb = content_to_pixel(line_p13);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 14.5) {
				float2 la = content_to_pixel(line_p13);
				float2 lb = content_to_pixel(line_p14);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			if (line_count > 15.5) {
				float2 la = content_to_pixel(line_p14);
				float2 lb = content_to_pixel(line_p15);
				float  ld = seg_dist(px, la, lb);
				line_a = max(line_a, (1.0 - smoothstep(line_hw - aa, line_hw + aa, ld)) * line_alpha);
			}
			col.rgb = lerp(col.rgb, highlight_color.rgb, saturate(line_a));
		}

		// Spotlight: dim, halo shadow, border, drop and zoom animation.
		if (spotlight_enabled > 0.5 && spot_amount > 0.001) {
			float aa = max(1.0, target_size.y * 0.0015);
			float outside = smoothstep(-aa, aa, spot_sd);

			if (spotlight_shadow_enabled > 0.5 && spotlight_shadow_alpha > 0.001) {
				float2 sp = px - spotlight_shadow_offset;
				float  sd = spotlight_sd(sp);
				float  halo = (1.0 - smoothstep(0.0, max(spotlight_shadow_blur, aa),
							 abs(sd))) *
					     outside;
				halo *= spotlight_shadow_alpha * spot_amount;
				col.rgb = lerp(col.rgb, spotlight_shadow_color.rgb, saturate(halo));
			}

			col.rgb *= (1.0 - spotlight_dim * outside * 0.85 * spot_amount);

			if (spotlight_border_enabled > 0.5) {
				float hw = max(spotlight_border_width, 0.5) * 0.5;
				float border = 1.0 - smoothstep(hw - aa, hw + aa, abs(spot_sd));
				border *= spotlight_border_color.a * spot_amount;
				col.rgb = lerp(col.rgb, spotlight_border_color.rgb, saturate(border));
			}
		}

		// Cursor
		if (cursor_enabled > 0.5) {
			float2 cpx   = content_to_pixel(cursor_pos);
			float2 local = rotate2(px - cpx, -cursor_rotation);
			float  icon  = max(target_size.y * 0.030 * cursor_scale, 8.0);

			if (cursor_tex_enabled > 0.5) {
				// anchor = icon center so the hotspot lands on the pointer
				float2 anchor = (float2(0.5, 0.5) - cursor_hotspot) * icon;
				float2 cuv    = (local - anchor) / icon + 0.5;

				if (cursor_shadow > 0.5) {
					float2 scuv = cuv - float2(0.07, 0.10);
					if (scuv.x >= 0.0 && scuv.x <= 1.0 && scuv.y >= 0.0 && scuv.y <= 1.0) {
						float2 sauv = cursor_cell_off + scuv * cursor_cell_scale;
						float  sa   = cursor_tex.Sample(def_sampler, sauv).a;
						col.rgb = lerp(col.rgb, float3(0.0, 0.0, 0.0),
							       saturate(sa * 0.35 * cursor_opacity * mask));
					}
				}

				if (cuv.x >= 0.0 && cuv.x <= 1.0 && cuv.y >= 0.0 && cuv.y <= 1.0) {
					float2 auv = cursor_cell_off + cuv * cursor_cell_scale;
					float4 ic  = cursor_tex.Sample(def_sampler, auv);
					col.rgb = lerp(col.rgb, ic.rgb, saturate(ic.a * cursor_opacity * mask));
				}
			} else {
				// Procedural fallback (light arrow with dark border)
				float  u     = max(target_size.y * 0.001 * cursor_scale, 0.5);
				float  corta = max(1.0, u * 0.12);
				float2 a0    = float2(0.0, 0.0) * u;
				float2 a1    = float2(0.0, 20.0) * u;
				float2 a2    = float2(14.0, 14.0) * u;

				if (cursor_shadow > 0.5) {
					float2 sp = local - float2(2.0, 3.0) * u;
					float  ds = sd_triangle(sp, a0, a1, a2);
					float  sa = (1.0 - smoothstep(-corta, corta, ds)) * 0.35 * cursor_opacity * mask;
					col.rgb   = lerp(col.rgb, float3(0.0, 0.0, 0.0), saturate(sa));
				}

				float d      = sd_triangle(local, a0, a1, a2);
				float fill   = 1.0 - smoothstep(-corta, corta, d);
				float border = 1.0 - smoothstep(corta, corta * 3.0, abs(d));

				col.rgb = lerp(col.rgb, float3(0.0, 0.0, 0.0),
					       saturate(max(fill, border) * cursor_opacity * mask));
				col.rgb = lerp(col.rgb, float3(1.0, 1.0, 1.0),
					       saturate(fill * cursor_opacity * mask));
			}
		}
	}

	// Normal backgrounds replace the source output with an opaque frame.
	// Transparent mode lets the scene below show through the padding.
	if (bg_transparent < 0.5)
		col.a = 1.0;
	return col;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSCompose(vert_in);
	}
}

// Diagnostic technique (TOPSCREEN_TECH=passthrough): draws only the source,
// no background/cursor/clicks. Useful to isolate shader vs. pipeline issues.
float4 PSPassThrough(VertInOut vert_in) : TARGET
{
	return image.Sample(def_sampler, vert_in.uv);
}

technique PassThrough
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSPassThrough(vert_in);
	}
}
