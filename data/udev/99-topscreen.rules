# TopScreen - access to /dev/input for passive input (Tier 3, Linux/Wayland).
#
# Install in /etc/udev/rules.d/99-topscreen.rules and reload:
#   sudo cp 99-topscreen.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# The "uaccess" tag makes logind grant access to the active session.
# Alternative (less granular): add the user to the "input" group.

SUBSYSTEM=="input", GROUP="input"

KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess", MODE="0660"
KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1",    TAG+="uaccess", MODE="0660"
KERNEL=="event*", ENV{ID_INPUT_TOUCHPAD}=="1", TAG+="uaccess", MODE="0660"
