#pragma once

#include "QString"
#include "QWidget"

/* Minimal stub for QCheckBox (only for the dock compile check). */
class QCheckBox : public QWidget {
public:
	explicit QCheckBox(const QString &text, QWidget *parent = nullptr) : QWidget(parent) { (void)text; }

	void setChecked(bool v) { checked_ = v; }
	bool isChecked() const { return checked_; }

	void stateChanged(int); /* signal */

private:
	bool checked_ = false;
};
