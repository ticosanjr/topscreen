#pragma once

#include "QString"

#include <vector>

/* Minimal stub for QStringList (only for the dock compile check). */
class QStringList {
public:
	QStringList &operator<<(const QString &s)
	{
		items_.push_back(s);
		return *this;
	}
	const std::vector<QString> &items() const { return items_; }

private:
	std::vector<QString> items_;
};
